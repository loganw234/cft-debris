let hs13 = select(ge13, bs13, hs12)
let ge14 = bh14 <= hh
let h0_14 = select(ge14, bh14, h0_13)
let rh14 = select(ge14, br14, rh13)
let hs14 = select(ge14, bs14, hs13)
let ge15 = bh15 <= hh
let h0_15 = select(ge15, bh15, h0_14)
let rh15 = select(ge15, br15, rh14)
