let h0_16 = select(ge16, bh16, h0_15)
let rh16 = select(ge16, br16, rh15)
let hs16 = select(ge16, bs16, hs15)
let ge17 = bh17 <= hh
let h0_17 = select(ge17, bh17, h0_16)
let rh17 = select(ge17, br17, rh16)
let hs17 = select(ge17, bs17, hs16)
let ge18 = bh18 <= hh
let h0_18 = select(ge18, bh18, h0_17)
let rh18 = select(ge18, br18, rh17)
let hs18 = select(ge18, bs18, hs17)
let ge19 = bh19 <= hh
let h0_19 = select(ge19, bh19, h0_18)
let rh19 = select(ge19, br19, rh18)
let hs19 = select(ge19, bs19, hs18)
let ge20 = bh20 <= hh
let h0_20 = select(ge20, bh20, h0_19)
let rh20 = select(ge20, br20, rh19)
let hs20 = select(ge20, bs20, hs19)
let ge21 = bh21 <= hh
let h0_21 = select(ge21, bh21, h0_20)
let rh21 = select(ge21, br21, rh20)
let hs21 = select(ge21, bs21, hs20)
let ge22 = bh22 <= hh
let h0_22 = select(ge22, bh22, h0_21)
let rh22 = select(ge22, br22, rh21)
let hs22 = select(ge22, bs22, hs21)
let ge23 = bh23 <= hh
let h0_23 = select(ge23, bh23, h0_22)
let rh23 = select(ge23, br23, rh22)
let hs23 = select(ge23, bs23, hs22)
let ge24 = bh24 <= hh
