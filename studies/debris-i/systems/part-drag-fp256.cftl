let hs25 = select(ge25, bs25, hs24)
let ge26 = bh26 <= hh
let h0_26 = select(ge26, bh26, h0_25)
let rh26 = select(ge26, br26, rh25)
let hs26 = select(ge26, bs26, hs25)
let ge27 = bh27 <= hh
let h0_27 = select(ge27, bh27, h0_26)
let rh27 = select(ge27, br27, rh26)
let hs27 = select(ge27, bs27, hs26)
let ud = -((hh - h0_27) / hs27)
let rhod = rh27 * exp(ud)
let vr0 = fma(io2, y, fma(-io1, z, vx))
let vr1 = fma(io0, z, fma(-io2, x, vy))
let vr2 = fma(io1, x, fma(-io0, y, vz))
let vn = sqrt(vr0 * vr0 + vr1 * vr1 + vr2 * vr2)
let kd = -((bc * rhod) * vn)
let drx = kd * vr0
let dry = kd * vr1
let drz = kd * vr2
next o0 = drx
next o1 = dry
next o2 = drz
step   map
