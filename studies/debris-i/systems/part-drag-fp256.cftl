let hs8 = select(ge8, bs8, hs7)
let ge9 = bh9 <= hh
let h0_9 = select(ge9, bh9, h0_8)
let rh9 = select(ge9, br9, rh8)
let hs9 = select(ge9, bs9, hs8)
let ge10 = bh10 <= hh
let h0_10 = select(ge10, bh10, h0_9)
let rh10 = select(ge10, br10, rh9)
let hs10 = select(ge10, bs10, hs9)
let ge11 = bh11 <= hh
let h0_11 = select(ge11, bh11, h0_10)
let rh11 = select(ge11, br11, rh10)
