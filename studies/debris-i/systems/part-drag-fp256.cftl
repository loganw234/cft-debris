; cft-debris DEBRIS-I (MIT licence), written by tests/i_gen.py: part drag of the program (degree 7, 28 bands, frame degrees 7 and 3), a map
; every data value is a param or a lane param, default 0, filled per run; no data is in this file
system dpart_drag
format fp256
round  rne
state  o0, o1, o2
lane param x = 0, y = 0, z = 0, vx = 0, vy = 0, vz = 0, io0 = 0, io1 = 0
lane param io2 = 0, bc = 0, bh0 = 0, bh1 = 0, bh2 = 0, bh3 = 0, bh4 = 0, bh5 = 0
lane param bh6 = 0, bh7 = 0, bh8 = 0, bh9 = 0, bh10 = 0, bh11 = 0, bh12 = 0, bh13 = 0
lane param bh14 = 0, bh15 = 0, bh16 = 0, bh17 = 0, bh18 = 0, bh19 = 0, bh20 = 0, bh21 = 0
lane param bh22 = 0, bh23 = 0, bh24 = 0, bh25 = 0, bh26 = 0, bh27 = 0, br0 = 0, br1 = 0
lane param br2 = 0, br3 = 0, br4 = 0, br5 = 0, br6 = 0, br7 = 0, br8 = 0, br9 = 0
lane param br10 = 0, br11 = 0, br12 = 0, br13 = 0, br14 = 0, br15 = 0, br16 = 0, br17 = 0
lane param br18 = 0, br19 = 0, br20 = 0, br21 = 0, br22 = 0, br23 = 0, br24 = 0, br25 = 0
lane param br26 = 0, br27 = 0, bs0 = 0, bs1 = 0, bs2 = 0, bs3 = 0, bs4 = 0, bs5 = 0
lane param bs6 = 0, bs7 = 0, bs8 = 0, bs9 = 0, bs10 = 0, bs11 = 0, bs12 = 0, bs13 = 0
lane param bs14 = 0, bs15 = 0, bs16 = 0, bs17 = 0, bs18 = 0, bs19 = 0, bs20 = 0, bs21 = 0
lane param bs22 = 0, bs23 = 0, bs24 = 0, bs25 = 0, bs26 = 0, bs27 = 0, rearth = 0
let r2 = x * x + y * y + z * z
let rn = sqrt(r2)
let hh = rn - rearth
let ge1 = bh1 <= hh
let h0_1 = select(ge1, bh1, bh0)
let rh1 = select(ge1, br1, br0)
let hs1 = select(ge1, bs1, bs0)
let ge2 = bh2 <= hh
let h0_2 = select(ge2, bh2, h0_1)
let rh2 = select(ge2, br2, rh1)
let hs2 = select(ge2, bs2, hs1)
let ge3 = bh3 <= hh
let h0_3 = select(ge3, bh3, h0_2)
let rh3 = select(ge3, br3, rh2)
let hs3 = select(ge3, bs3, hs2)
let ge4 = bh4 <= hh
let h0_4 = select(ge4, bh4, h0_3)
let rh4 = select(ge4, br4, rh3)
let hs4 = select(ge4, bs4, hs3)
