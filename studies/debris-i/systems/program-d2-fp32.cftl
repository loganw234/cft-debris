let rh27 = select(ge27, br27, rh26)
let hs27 = select(ge27, bs27, hs26)
let ud = -((hh - h0_27) / hs27)
let rhod = rh27 * exp(ud)
let vr0 = fma(om2, y, fma(-om1, z, vx))
let vr1 = fma(om0, z, fma(-om2, x, vy))
let vr2 = fma(om1, x, fma(-om0, y, vz))
let vn = sqrt(vr0 * vr0 + vr1 * vr1 + vr2 * vr2)
let kd = -((bc * rhod) * vn)
let drx = kd * vr0
let dry = kd * vr1
let drz = kd * vr2
d/dt t  = 1
d/dt x  = vx
d/dt y  = vy
d/dt z  = vz
d/dt vx = (((cx + hv0) + as0) + am0) + drx
d/dt vy = (((cy + hv1) + as1) + am1) + dry
d/dt vz = (((cz + hv2) + as2) + am2) + drz
step   rk4, h = 15
