let qsm = gmm / (q2m * sqrt(q2m))
let am0 = qdm * dm0 - qsm * mn0
let am1 = qdm * dm1 - qsm * mn1
let am2 = qdm * dm2 - qsm * mn2
let hh = rn - rearth
let ge1 = bh1 <= hh
let h0_1 = select(ge1, bh1, bh0)
let rh1 = select(ge1, br1, br0)
let hs1 = select(ge1, bs1, bs0)
let ge2 = bh2 <= hh
let h0_2 = select(ge2, bh2, h0_1)
let rh2 = select(ge2, br2, rh1)
let hs2 = select(ge2, bs2, hs1)
let ge3 = bh3 <= hh
let h0_3 = select(ge3, bh3, h0_2)
